{
  "name": "Shairport Sync (Pipe)",
  "version": "1.0.7",
  "slug": "shairport_sync",
  "description": "AirPlay Receiver mit Named Pipe Support für OwnTone",
  "url": "https://github.com/xxTesafilmxx/hassio",
  "startup": "application",
  "arch": [
    "aarch64",
    "amd64",
    "armhf",
    "armv7"
  ],
  "boot": "auto",
  "init": false,
  "host_network": true,
  "audio": true,
  "map": [
    "share:rw",
    "config:rw"
  ],
  "options": {
    "airplay_name": "HomeAssistant",
    "pipe_path": "/share/owntone/music/airplay.pipe",
    "log_level": "info"
  },
  "schema": {
    "airplay_name": "str",
    "pipe_path": "str",
    "log_level": "match(^(trace|debug|info|notice|warning|error|fatal)$)"
  }
}
